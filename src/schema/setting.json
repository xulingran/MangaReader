{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "LayoutMode": {
            "description": "enum layoutmode of Reader component",
            "enum": [
                "horizontal",
                "vertical",
                "multiple"
            ],
            "type": "string"
        },
        "MultipleSeat": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        },
        "PageKeys": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        },
        "ReaderDirection": {
            "enum": [
                "left",
                "right"
            ],
            "type": "string"
        },
        "Sequence": {
            "enum": [
                "Asc",
                "Desc"
            ],
            "type": "string"
        },
        "ThemeMode": {
            "description": "应用外观偏好；System 由 Android 当前 uiMode 解析为亮色或深色。",
            "enum": [
                "light",
                "dark",
                "system"
            ],
            "type": "string"
        },
        "Timer": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        }
    },
    "properties": {
        "androidDownloadPath": {
            "type": "string"
        },
        "direction": {
            "$ref": "#/definitions/ReaderDirection",
            "description": "漫画阅读方向"
        },
        "mode": {
            "$ref": "#/definitions/LayoutMode",
            "description": "布局模式"
        },
        "pageKeys": {
            "$ref": "#/definitions/PageKeys",
            "description": "是否监听实体翻页键"
        },
        "seat": {
            "$ref": "#/definitions/MultipleSeat",
            "description": "双页模式的图片位置"
        },
        "sequence": {
            "$ref": "#/definitions/Sequence",
            "description": "章节排列顺序"
        },
        "themeMode": {
            "$ref": "#/definitions/ThemeMode",
            "description": "应用外观：亮色、深色或跟随系统"
        },
        "timer": {
            "$ref": "#/definitions/Timer",
            "description": "定时翻页"
        },
        "timerGap": {
            "type": "number"
        }
    },
    "required": [
        "androidDownloadPath",
        "direction",
        "mode",
        "pageKeys",
        "seat",
        "sequence",
        "themeMode",
        "timer",
        "timerGap"
    ],
    "type": "object"
}

