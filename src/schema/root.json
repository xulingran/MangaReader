{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
        "AsyncStatus": {
            "description": "enum of any async status",
            "enum": [
                0,
                1,
                2,
                3
            ],
            "type": "number"
        },
        "IconLabel": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        },
        "Job": {
            "properties": {
                "chapterHash": {
                    "type": "string"
                },
                "headers": {
                    "$ref": "#/definitions/Record<string,string>"
                },
                "index": {
                    "type": "number"
                },
                "jobId": {
                    "type": "string"
                },
                "source": {
                    "type": "string"
                },
                "status": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "taskId": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/TaskType"
                }
            },
            "required": [
                "chapterHash",
                "index",
                "jobId",
                "source",
                "status",
                "taskId",
                "type"
            ],
            "type": "object"
        },
        "LatestRelease": {
            "properties": {
                "changeLog": {
                    "type": "string"
                },
                "file": {
                    "properties": {
                        "apk": {
                            "properties": {
                                "downloadUrl": {
                                    "type": "string"
                                },
                                "size": {
                                    "type": "number"
                                }
                            },
                            "required": [
                                "downloadUrl",
                                "size"
                            ],
                            "type": "object"
                        }
                    },
                    "required": [
                        "apk"
                    ],
                    "type": "object"
                },
                "publishTime": {
                    "type": "string"
                },
                "url": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "changeLog",
                "publishTime",
                "url",
                "version"
            ],
            "type": "object"
        },
        "LayoutMode": {
            "description": "enum layoutmode of Reader component",
            "enum": [
                "horizontal",
                "vertical",
                "multiple"
            ],
            "type": "string"
        },
        "MultipleSeat": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        },
        "PageKeys": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        },
        "Plugin": {
            "enum": [
                "MHGM",
                "MBZ",
                "BZM",
                "RM5",
                "HCOMIC",
                "BIKA",
                "NH",
                "MOEIMG"
            ],
            "type": "string"
        },
        "ReaderDirection": {
            "enum": [
                "left",
                "right"
            ],
            "type": "string"
        },
        "Record<string,AsyncStatus>": {
            "type": "object"
        },
        "Record<string,Chapter|undefined>": {
            "type": "object"
        },
        "Record<string,Manga|undefined>": {
            "type": "object"
        },
        "Record<string,string>": {
            "type": "object"
        },
        "Record<string,{page?:number|undefined;chapter?:string|undefined;title?:string|undefined;}>": {
            "type": "object"
        },
        "Record<string,{status:AsyncStatus;actionId:string;}>": {
            "type": "object"
        },
        "Record<string,{total:number;progress:number;imagesLoaded:number[];isVisited:boolean;}>": {
            "type": "object"
        },
        "Release": {
            "properties": {
                "latest": {
                    "$ref": "#/definitions/LatestRelease"
                },
                "loadStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "name": {
                    "type": "string"
                },
                "publishTime": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "loadStatus",
                "name",
                "publishTime",
                "version"
            ],
            "type": "object"
        },
        "Sequence": {
            "enum": [
                "Asc",
                "Desc"
            ],
            "type": "string"
        },
        "Task": {
            "properties": {
                "chapterHash": {
                    "type": "string"
                },
                "downloadPath": {
                    "type": "string"
                },
                "fail": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "headers": {
                    "$ref": "#/definitions/Record<string,string>"
                },
                "pending": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "queue": {
                    "items": {
                        "properties": {
                            "index": {
                                "type": "number"
                            },
                            "jobId": {
                                "type": "string"
                            },
                            "source": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "index",
                            "jobId",
                            "source"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "status": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "success": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "taskId": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/definitions/TaskType"
                }
            },
            "required": [
                "chapterHash",
                "downloadPath",
                "fail",
                "pending",
                "queue",
                "status",
                "success",
                "taskId",
                "title",
                "type"
            ],
            "type": "object"
        },
        "TaskType": {
            "description": "任务类型",
            "enum": [
                0,
                1
            ],
            "type": "number"
        },
        "ThemeMode": {
            "description": "应用外观偏好；System 由 Android 当前 uiMode 解析为亮色或深色。",
            "enum": [
                "light",
                "dark",
                "system"
            ],
            "type": "string"
        },
        "Timer": {
            "enum": [
                0,
                1
            ],
            "type": "number"
        }
    },
    "properties": {
        "app": {
            "properties": {
                "launchStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "message": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "required": [
                "launchStatus",
                "message"
            ],
            "type": "object"
        },
        "batch": {
            "properties": {
                "fail": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "loadStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "queue": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "stack": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "success": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                }
            },
            "required": [
                "fail",
                "loadStatus",
                "queue",
                "stack",
                "success"
            ],
            "type": "object"
        },
        "chapter": {
            "properties": {
                "loadByHash": {
                    "$ref": "#/definitions/Record<string,AsyncStatus>"
                },
                "openDrawer": {
                    "type": "boolean"
                },
                "showDrawer": {
                    "type": "boolean"
                }
            },
            "required": [
                "loadByHash",
                "openDrawer",
                "showDrawer"
            ],
            "type": "object"
        },
        "datasync": {
            "properties": {
                "backupStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "clearStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "restoreStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "syncStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                }
            },
            "required": [
                "backupStatus",
                "clearStatus",
                "restoreStatus",
                "syncStatus"
            ],
            "type": "object"
        },
        "dict": {
            "properties": {
                "chapter": {
                    "$ref": "#/definitions/Record<string,Chapter|undefined>"
                },
                "lastWatch": {
                    "$ref": "#/definitions/Record<string,{page?:number|undefined;chapter?:string|undefined;title?:string|undefined;}>"
                },
                "manga": {
                    "$ref": "#/definitions/Record<string,Manga|undefined>"
                },
                "record": {
                    "$ref": "#/definitions/Record<string,{total:number;progress:number;imagesLoaded:number[];isVisited:boolean;}>"
                }
            },
            "required": [
                "chapter",
                "lastWatch",
                "manga",
                "record"
            ],
            "type": "object"
        },
        "discovery": {
            "properties": {
                "filter": {
                    "$ref": "#/definitions/Record<string,string>"
                },
                "isEnd": {
                    "type": "boolean"
                },
                "list": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "loadStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "page": {
                    "type": "number"
                }
            },
            "required": [
                "filter",
                "isEnd",
                "list",
                "loadStatus",
                "page"
            ],
            "type": "object"
        },
        "favorites": {
            "items": {
                "properties": {
                    "enableBatch": {
                        "type": "boolean"
                    },
                    "isTrend": {
                        "type": "boolean"
                    },
                    "mangaHash": {
                        "type": "string"
                    }
                },
                "required": [
                    "enableBatch",
                    "isTrend",
                    "mangaHash"
                ],
                "type": "object"
            },
            "type": "array"
        },
        "manga": {
            "properties": {
                "loadByHash": {
                    "$ref": "#/definitions/Record<string,{status:AsyncStatus;actionId:string;}>"
                }
            },
            "required": [
                "loadByHash"
            ],
            "type": "object"
        },
        "onlineFavorites": {
            "properties": {
                "isEnd": {
                    "type": "boolean"
                },
                "list": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "loadStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "page": {
                    "type": "number"
                },
                "source": {
                    "description": "当前列表所属来源；切换来源时 slice 自动重置列表",
                    "enum": [
                        "BIKA",
                        "BZM",
                        "HCOMIC",
                        "MBZ",
                        "MHGM",
                        "MOEIMG",
                        "NH",
                        "RM5"
                    ],
                    "type": "string"
                }
            },
            "required": [
                "isEnd",
                "list",
                "loadStatus",
                "page"
            ],
            "type": "object"
        },
        "plugin": {
            "properties": {
                "list": {
                    "items": {
                        "properties": {
                            "description": {
                                "type": "string"
                            },
                            "disabled": {
                                "type": "boolean"
                            },
                            "href": {
                                "type": "string"
                            },
                            "injectedJavaScript": {
                                "type": "string"
                            },
                            "label": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            },
                            "score": {
                                "type": "number"
                            },
                            "userAgent": {
                                "type": "string"
                            },
                            "value": {
                                "$ref": "#/definitions/Plugin"
                            }
                        },
                        "required": [
                            "description",
                            "disabled",
                            "href",
                            "label",
                            "name",
                            "score",
                            "value"
                        ],
                        "type": "object"
                    },
                    "type": "array"
                },
                "source": {
                    "$ref": "#/definitions/Plugin"
                }
            },
            "required": [
                "list",
                "source"
            ],
            "type": "object"
        },
        "release": {
            "$ref": "#/definitions/Release"
        },
        "search": {
            "properties": {
                "filter": {
                    "$ref": "#/definitions/Record<string,string>"
                },
                "isEnd": {
                    "type": "boolean"
                },
                "keyword": {
                    "type": "string"
                },
                "list": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "loadStatus": {
                    "$ref": "#/definitions/AsyncStatus"
                },
                "page": {
                    "type": "number"
                }
            },
            "required": [
                "filter",
                "isEnd",
                "keyword",
                "list",
                "loadStatus",
                "page"
            ],
            "type": "object"
        },
        "setting": {
            "properties": {
                "androidDownloadPath": {
                    "type": "string"
                },
                "direction": {
                    "$ref": "#/definitions/ReaderDirection",
                    "description": "漫画阅读方向"
                },
                "iconLabel": {
                    "$ref": "#/definitions/IconLabel",
                    "description": "图标按钮下方是否显示说明文字"
                },
                "mode": {
                    "$ref": "#/definitions/LayoutMode",
                    "description": "布局模式"
                },
                "pageKeys": {
                    "$ref": "#/definitions/PageKeys",
                    "description": "是否监听实体翻页键"
                },
                "seat": {
                    "$ref": "#/definitions/MultipleSeat",
                    "description": "双页模式的图片位置"
                },
                "sequence": {
                    "$ref": "#/definitions/Sequence",
                    "description": "章节排列顺序"
                },
                "themeMode": {
                    "$ref": "#/definitions/ThemeMode",
                    "description": "应用外观：亮色、深色或跟随系统"
                },
                "timer": {
                    "$ref": "#/definitions/Timer",
                    "description": "定时翻页"
                },
                "timerGap": {
                    "type": "number"
                }
            },
            "required": [
                "androidDownloadPath",
                "direction",
                "iconLabel",
                "mode",
                "pageKeys",
                "seat",
                "sequence",
                "themeMode",
                "timer",
                "timerGap"
            ],
            "type": "object"
        },
        "task": {
            "properties": {
                "job": {
                    "properties": {
                        "list": {
                            "items": {
                                "$ref": "#/definitions/Job"
                            },
                            "type": "array"
                        },
                        "max": {
                            "type": "number"
                        },
                        "thread": {
                            "items": {
                                "properties": {
                                    "jobId": {
                                        "type": "string"
                                    },
                                    "taskId": {
                                        "type": "string"
                                    }
                                },
                                "required": [
                                    "jobId",
                                    "taskId"
                                ],
                                "type": "object"
                            },
                            "type": "array"
                        }
                    },
                    "required": [
                        "list",
                        "max",
                        "thread"
                    ],
                    "type": "object"
                },
                "list": {
                    "items": {
                        "$ref": "#/definitions/Task"
                    },
                    "type": "array"
                }
            },
            "required": [
                "job",
                "list"
            ],
            "type": "object"
        }
    },
    "required": [
        "app",
        "batch",
        "chapter",
        "datasync",
        "dict",
        "discovery",
        "favorites",
        "manga",
        "onlineFavorites",
        "plugin",
        "release",
        "search",
        "setting",
        "task"
    ],
    "type": "object"
}

